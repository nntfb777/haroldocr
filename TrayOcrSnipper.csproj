<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = ứng dụng Windows không có cửa sổ Console -->
    <OutputType>WinExe</OutputType>

    <!--
      QUAN TRỌNG: dùng Target Framework Moniker (TFM) có kèm phiên bản Windows SDK.
      Với TFM này, .NET SDK tự động tham chiếu các WinRT projection (Windows.Media.Ocr,
      Windows.Graphics.Imaging...) qua C#/WinRT, nên KHÔNG cần thêm gói NuGet
      Microsoft.Windows.SDK.Contracts (gói đó chỉ dành cho .NET Framework / .NET Core 3.x
      và sẽ gây xung đột nếu thêm vào cùng TFM này).
      Dùng .NET 9: đổi thành net9.0-windows10.0.19041.0
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- DPI được khai báo trong app.manifest (PerMonitorV2) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Cố ý khai báo DPI trong manifest nên tắt cảnh báo WFAC010 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <RootNamespace>TrayOcrSnipper</RootNamespace>
    <AssemblyName>TrayOcrSnipper</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Tray OCR Snipper</Product>

    <!-- Tesseract dùng DLL gốc 64-bit, nên ứng dụng phải chạy 64-bit -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tesseract OCR (kèm sẵn DLL tesseract + leptonica cho x64). Dùng cho tiếng Việt. -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

</Project>